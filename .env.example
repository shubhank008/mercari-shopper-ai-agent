# LLM API Keys
## MAIN MODEL
ANTHROPIC_API_KEY=your_claude_api_key_here
# Sonnet 3.5 is retired
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# (Optional) For fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_ID=gpt-4o

# Logging Level (Default: WARNING for clean UI, set to INFO/DEBUG for detailed)
LOG_LEVEL=WARNING


# Enables fallback to other LLM models if primary provider is down (Anthropic->OpenAI)
# If enabled, make sure OPENAI_API_KEY is set in .env and openai library is installed in requirements.txt
ENABLE_LLM_FALLBACK=true


# Enables using other fallback scraping mecanisms for Mercari (Priority: web-> mercarpi-> playwright)
ENABLE_MERCARI_FALLBACK=true
# Enables use of MercariPY library - https://github.com/take-kun/mercapi
# Make sure the library is installed
# Mercarpi is preferred over Playwright due to Playwright being more resource heavy and timetaking to execute
ENABLE_MERCARI_FALLBACK_MERCARPI=true
# Playwright is last fallback due to being more resource heavy
ENABLE_MERCARI_FALLBACK_PLAYWRIGHT=false


# Operational Thresholds
## Max characters to truncate product description
MAX_DESCRIPTION_LENGTH=1500

# Maximum number of items retrieved by the Search Scraper (Broad Results)
MAX_ITEMS_PER_SEARCH=25
# Maximum number of items picked by the Agent from broad results 
# These are processed through Detailed Data Fetching for RAG/DeepEnrichment
MAX_ITEMS_FOR_ENRICHMENT=10

# Max turns/loop allowed to the Multi-Step Agent
# For safety reasons this cannot be lower than 5
MAX_TOOL_CALL_LOOPS=7
# Timeout for the Mercari/Backend scrapers
SCRAPER_TIMEOUT_SECONDS=10.0
# Timeout for each LLM request, keep this as high but bearable as possible
LLM_TIMEOUT_SECONDS=60.0
# Browser demo sessions are in-memory and expire after this many idle seconds
WEB_SESSION_IDLE_SECONDS=1800

## !!EXPERIMENTAL - DONOT ENABLE EXCEPT TESTING!!
## If enabled, Agent asks the user followup question for any missing parameters (primarily cost/budget) in their initial prompt. 
## Improves the overall search and filtering compared to broad search
## Example: If user only asked "Find me a macbook", Agent will do a single followup question "Do you have any budget in mind and any specific condition (new/used)"
## EXPERIMENTAL
ENABLE_FOLLOWUP_QUESTIONS=false

## !!EXPERIMENTAL - DONOT ENABLE EXCEPT TESTING!!
## Enable saving each session's final context in session memory, so the Agent will remember previous conversation / product details in any followup queries.
## Disabling it lets the Agent treat every conversation state (Question-Answer) as a new session, unaware of previous discussion.
## Will increase overall context window size, and thus token / cost usage. Only enable it if need session-memory aware agent.
ENABLE_SESSION_MEMORY=false